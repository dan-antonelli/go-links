{
  "name": "golinks",
  "version": "0.1.0",
  "private": true,
  "description": "Internal go-links service: domain core + HTTP + CLI adapters, with OpenTelemetry.",
  "main": "dist/http/server.js",
  "bin": {
    "golinks": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/http/server.ts",
    "build": "tsc",
    "postbuild": "chmod +x dist/cli/index.js",
    "start": "node dist/http/server.js",
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "express": "^5.2.1",
    "zod": "^4.4.3",
    "commander": "^14.0.3",
    "pino": "^10.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-express": "^0.69.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.23.1",
    "@types/node": "^22.20.1",
    "@types/express": "^5.0.6",
    "vitest": "^4.1.10",
    "prettier": "^3.9.6",
    "eslint": "^10.8.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.65.0",
    "eslint-config-prettier": "^10.1.8"
  }
}
